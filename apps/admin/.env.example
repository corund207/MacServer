# Documentation only: values must be supplied by an operator-managed service.
# No dotenv loader; do not place actual identity/paths/secrets in Git.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8443
ADMIN_ORIGIN=https://appliance.example.ts.net:8443
ADMIN_CREDENTIALS_FILE=/etc/macserver-admin/credentials.json
ADMIN_TLS_KEY=/etc/macserver-admin/tls.key
ADMIN_TLS_CERT=/etc/macserver-admin/tls.crt
ADMIN_AUDIT_FILE=/var/lib/macserver-admin/audit.jsonl
# Optional curated non-secret export root, read-only to this service account.
# ADMIN_FILE_ROOT=/srv/macserver-admin-exports
