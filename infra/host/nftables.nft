# Candidate only. No flush ruleset: coexistence must be reviewed on target.
# Applies to HOST traffic only; Docker forwarding requires separate validation.
table inet macserver {
  chain input {
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state invalid drop
    ct state established,related accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    # DHCP client replies. Review interfaces on target.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
    iifname "tailscale0" tcp dport { 22, 8443 } accept
  }
}
