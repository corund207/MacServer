[Unit]
Description=MacServer read-only console display on tty1
Documentation=file:/opt/macserver/docs/DASHBOARD.md
After=systemd-user-sessions.service macserver-status-collector.timer
Conflicts=getty@tty1.service
ConditionPathExists=/etc/macserver-dashboard/DEPLOYMENT-APPROVED
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=macserver-dashboard
Group=macserver-dashboard
Environment=TERM=linux
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/python3 /opt/macserver/apps/console/macserver_top.py --kiosk --status /run/macserver/status.json
# systemd opens tty1 before dropping privileges; the display only ever writes to it.
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
# No network access at all. The host network namespace is kept so /proc/net/dev
# reports the Mac's real interfaces.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadOnlyPaths=/run/macserver
MemoryMax=128M
CPUQuota=15%
TasksMax=8
LimitNOFILE=64
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
