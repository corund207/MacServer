[Unit]
Description=MacServer network watch (who is on the local network, exactly, and alerts about strangers)
Documentation=file:///usr/local/lib/macserver/lan_devices.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/macserver/lan_devices.py watch
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30
# Devices name themselves, so everything they send is untrusted. The watch runs as a throwaway user
# whose only privilege is CAP_NET_RAW: a packet socket that reads discovery broadcasts (DHCP, mDNS,
# UPnP, NetBIOS, ARP) through a kernel filter. It opens no port and answers nothing; the firewall is
# unchanged. It sees only its own state directory, and reads (never writes) your names and trust list
# in /etc/macserver/devices-known.json. nmap runs unprivileged inside the same sandbox.
DynamicUser=yes
StateDirectory=macserver-devices
Environment=HOME=/var/lib/macserver-devices
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=300M
TasksMax=96
Nice=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
