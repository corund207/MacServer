[Unit]
Description=MacServer private admin page (127.0.0.1:8090, published on the tailnet by tailscale serve)
After=network.target

[Service]
User=macserver-admin
Group=macserver-admin
ExecStart=/usr/bin/python3 /opt/macserver/admin/server.py --port 8090 --status /run/macserver/status.json --conf /etc/macserver/macserver.conf --claude-request /run/macserver-admin/claude-request
# The only thing the page can write: "start" or "stop" for the Claude session, which
# the root-owned macserver-claude-control.path acts on.
RuntimeDirectory=macserver-admin
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
